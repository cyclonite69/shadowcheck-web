# ============================================================================
# ShadowCheck Test/Sandbox Environment Configuration Template (.env.test.example)
#
# Copy this file to .env.test for running docker-compose.test.yml with API keys:
#   docker compose --env-file .env --env-file .env.test -f docker-compose.test.yml up -d --build
#
# SECURITY:
#   - Real secret values belong ONLY in the untracked, gitignored .env.test file.
#   - .dockerignore excludes all root-level .env.* files from container build layers.
#   - NEVER commit real credentials to tracked repository files.
#
# NOTE ON DEFAULTS & OLD PINNED SETTINGS:
#   - DB_PASSWORD and DB_ADMIN_PASSWORD are intentionally omitted (they are
#     inherited from .env).
#   - Static AWS access keys (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) are omitted
#     because docker-compose.test.yml mounts your host ~/.aws read-only via
#     AWS_PROFILE=shadowcheck-sso. (Note: Bedrock analysis invokes Claude via AWS creds).
#   - Fixed runtime settings (DB_NAME=shadowcheck_test, PORT=3002, REDIS_DB=1,
#     SESSION_COOKIE_NAME=shadowcheck_session_test) now live in docker-compose.test.yml.
# ============================================================================

# ----------------------------------------------------------------------------
# Browser Origins (Optional Override)
# ----------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# ----------------------------------------------------------------------------
# Mapbox Visualization (QUOTA-SPENDING: consumes Mapbox API requests)
# Recommendation: use a dedicated sandbox token with strict URL / scope restrictions.
# ----------------------------------------------------------------------------
MAPBOX_TOKEN=<pk.your_mapbox_token_here>
MAPBOX_UNLIMITED_API_KEY=<your_mapbox_unlimited_key>

# ----------------------------------------------------------------------------
# Geocoding Providers (QUOTA-SPENDING / FINANCIAL COST)
# Recommendation: use free-tier / low-limit test keys for sandbox testing.
# ----------------------------------------------------------------------------
OPENCAGE_API_KEY=<your_opencage_key>
LOCATIONIQ_API_KEY=<your_locationiq_key>
GEOCODIO_API_KEY=<your_geocodio_key>
GOOGLE_MAPS_API_KEY=<your_google_maps_key>
SMARTY_AUTH_ID=<your_smarty_auth_id>
SMARTY_AUTH_TOKEN=<your_smarty_auth_token>

# ----------------------------------------------------------------------------
# WiGLE Forensics (QUOTA-SPENDING: consumes daily WiGLE API query credits)
# Recommendation: use a dedicated research account with low daily limits.
# ----------------------------------------------------------------------------
WIGLE_API_NAME=<your_wigle_api_name>
WIGLE_API_TOKEN=<your_wigle_api_token>
WIGLE_API_ENCODED=<your_wigle_api_encoded>

# ----------------------------------------------------------------------------
# Mobile Ingest API
# ----------------------------------------------------------------------------
SHADOWCHECK_API_KEY=<your_mobile_ingest_key>
